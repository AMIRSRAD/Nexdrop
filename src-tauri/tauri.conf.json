{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nexdrop",
  "version": "1.1.0",
  "identifier": "com.nexdrop.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null,
    "beforeDevCommand": "pnpm build",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexdrop",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --proxy-bypass-list=\"<-loopback>;<local>;localhost;127.0.0.1;*.localhost;tauri.localhost\"",
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "backgroundColor": "#0d0e11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Nexdrop",
    "copyright": "Copyright © 2026 Nexdrop",
    "category": "Utility",
    "shortDescription": "A fast, safe download manager with torrent support.",
    "longDescription": "Nexdrop accelerates downloads with multiple connections, resumes interrupted transfers, verifies file integrity, schedules downloads, and downloads torrents and magnet links. It integrates with your browser through an optional extension.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../extensions/nexdrop-browser-extension": "extension",
      "../extensions/signed": "extension-signed"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Nexdrop",
        "compression": "lzma",
        "installerHooks": "installer-hooks.nsh",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
