{
  "manifest_version": 3,
  "name": "Nexdrop — Modern Download Manager Integration",
  "version": "1.4.0",
  "description": "Sends downloads, videos and streams from your browser to Nexdrop, like IDM.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexdrop Download Manager"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "webRequest",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nexdrop@nexdrop.app",
      "strict_min_version": "115.0"
    }
  }
}
