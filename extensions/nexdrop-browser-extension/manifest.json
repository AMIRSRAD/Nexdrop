{
  "manifest_version": 3,
  "name": "Nexdrop — Modern Download Manager Integration",
  "version": "1.0.0",
  "description": "Seamlessly intercepts downloads, captures HTML5 video/audio streams, and routes files directly to Nexdrop Desktop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexdrop Download Manager"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:18888/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
